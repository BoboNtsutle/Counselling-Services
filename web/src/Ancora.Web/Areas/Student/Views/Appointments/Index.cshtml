@model List<Appointment>
@{ ViewData["Title"] = "My appointments"; }

<div class="page-head">
    <div><h1>My appointments</h1><p>Sessions that are waiting for approval or already approved.</p></div>
    <a asp-area="Student" asp-controller="Bookings" asp-action="Index" class="btn-ancora">Book a session</a>
</div>

<div class="card-a">
    @if (Model.Count == 0)
    {
        <div class="empty">You have no current appointments.</div>
    }
    else
    {
        <div class="table-wrap">
        <table class="table-a">
            <thead><tr><th>When</th><th>Psychologist</th><th>Reason</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td><strong>@a.AppointmentDate</strong><br /><span class="text-muted small">@a.AppointmentTime</span></td>
                    <td>@(string.IsNullOrEmpty(a.PsychologistName) ? "Will be assigned" : a.PsychologistName)</td>
                    <td>@a.Reason</td>
                    <td><partial name="_StatusBadge" model="a.Status" /></td>
                    <td class="text-end">
                        @* The form tag helper adds the anti-forgery token for us. *@
                        <form asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this appointment?');">
                            <input type="hidden" name="id" value="@a.Id" />
                            <button type="submit" class="btn-ghost">Cancel</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    }
</div>
