@model Appointment
@{ ViewData["Title"] = "Session"; }
@* MODULE 5 — Psychologist appointment details *@
<div class="page-head">
    <div><h1>@Model.StudentName</h1><p>@Model.AppointmentDate at @Model.AppointmentTime</p></div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="Students" asp-action="Details" asp-route-id="@Model.StudentId" class="btn-ancora">View student record</a>
        <a asp-controller="Dashboard" asp-action="Index" class="btn-ghost">← My appointments</a>
    </div>
</div>

<div class="card-a">
    <dl class="dl-a">
        <dt>Status</dt><dd><partial name="_StatusBadge" model="Model.Status" /></dd>
        <dt>Student number</dt><dd>@Model.StudentNumber</dd>
        <dt>Course</dt><dd>@Model.Course</dd>
        <dt>Reason</dt><dd>@Model.Reason</dd>
        <dt>Mood</dt><dd>@Model.Mood</dd>
        <dt>Urgency</dt><dd><span class="badge-a badge-@Model.Urgency">@Model.Urgency</span></dd>
    </dl>
</div>

<div class="card-a">
    <h2>Session</h2>
    <form asp-action="UpdateStatus" method="post" class="mb-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="mb-2">
            <label class="form-label">Change status</label>
            <select name="status" class="form-select">
                <option value="Approved">Approve</option>
                <option value="Rejected">Reject</option>
                <option value="Complete">Complete</option>
            </select>
        </div>
        <button class="btn btn-ancora" type="submit">Update status</button>
    </form>

    <h3>Session notes</h3>
    <form asp-action="SaveNotes" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="mb-2">
            <textarea name="notes" class="form-control" rows="6">@ViewBag.Notes</textarea>
        </div>
        <button class="btn btn-ghost" type="submit">Save notes</button>
    </form>

    @* Only an approved appointment can be moved. *@
    @if (Model.Status == AppointmentStatus.Approved)
    {
        <h3 class="mt-3">Reschedule</h3>
        <p class="text-muted small">Now booked for @Model.AppointmentDate at @Model.AppointmentTime. Choose a new day and hour; we check that you are free then.</p>
        <form asp-action="Reschedule" method="post" class="row g-2">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="col-6">
                <label class="form-label">New date</label>
                <input type="date" name="newDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-6">
                <label class="form-label">New time</label>
                <select name="newTime" class="form-select" required>
                    <option value="">Choose…</option>
                    @foreach (var slot in WorkingHours.Slots)
                    {
                        <option value="@slot">@slot</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <button class="btn btn-ghost mt-2" type="submit">Reschedule</button>
            </div>
        </form>
    }
</div>
