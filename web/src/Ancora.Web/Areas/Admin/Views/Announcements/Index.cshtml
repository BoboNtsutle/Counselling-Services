@model List<Announcement>
@{ ViewData["Title"] = "Announcements"; }
@* MODULE 4 — Announcements *@
<div class="page-head">
    <div><h1>Announcements</h1><p>Programmes and events — students see these in the mobile app.</p></div>
</div>

<div class="card-a">
    <h2>Publish announcement</h2>
    <form asp-area="Admin" asp-controller="Announcements" asp-action="Create" method="post" enctype="multipart/form-data" id="publishForm">
        <div class="mb-2">
            <label class="form-label">Title</label>
            <input name="Title" class="form-control" />
        </div>
        <div class="mb-2">
            <label class="form-label">Message</label>
            <textarea name="Message" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-2">
            <label class="form-label">Image or video (optional)</label>
            <input type="file" name="MediaFile" accept="image/*,video/*" class="form-control" />
        </div>
        <button class="btn-ancora" type="submit">Publish</button>
        <div id="publishSkeleton" class="mt-3" style="display:none;">
            <div class="d-flex gap-3">
                <div class="skeleton thumb"></div>
                <div style="flex:1">
                    <div class="skeleton title"></div>
                    <div class="skeleton line"></div>
                    <div class="skeleton line" style="width:80%"></div>
                </div>
            </div>
        </div>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="card-a"><div class="empty">Nothing published yet.</div></div>
}
@foreach (var a in Model)
{
    <div class="card-a">
        <div class="d-flex gap-3 align-items-start">
            @if (!string.IsNullOrEmpty(a.ImageUrl))
            {
                <img src="@a.ImageUrl" alt="" style="width:120px;height:80px;object-fit:cover;border-radius:10px" />
            }
            <div>
                <h2 class="mb-1">@a.Title</h2>
                <div class="text-muted small mb-2">@a.CreatedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")</div>
                <p class="mb-0">@a.Message</p>
            </div>
        </div>
    </div>
}
