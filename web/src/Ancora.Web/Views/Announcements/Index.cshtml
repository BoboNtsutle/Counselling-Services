@model List<Ancora.Web.Models.Announcement>
@{ ViewData["Title"] = "News"; }
<div class="page-head">
    <div><h1>News</h1><p>Programmes and events — students see these here and in the mobile app.</p></div>
</div>

@if (Model.Count == 0)
{
    <div class="card-a"><div class="empty">Nothing published yet.</div></div>
}
@foreach (var a in Model)
{
    <div class="card-a announcement-card">
        <div class="d-flex gap-3 align-items-start">
            @if (!string.IsNullOrEmpty(a.ImageUrl))
            {
                <div class="media-thumb">
                    <img src="@a.ImageUrl" alt="" class="media-thumb-img" />
                </div>
            }
            <div>
                <h2 class="mb-1">@a.Title</h2>
                <div class="text-muted small mb-2">@a.CreatedAt.LocalDateTime.ToString("d MMM yyyy, HH:mm")</div>
                <p class="mb-0">@a.Message</p>
            </div>
        </div>
    </div>
}
