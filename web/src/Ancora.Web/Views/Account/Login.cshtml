@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_AuthLayout";
}
<h2>Welcome back</h2>
<p class="sub">Sign in with your Ancora staff account.</p>

<form asp-action="Login" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="flash flash-err" role="alert"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="mb-4 text-end"><a asp-action="ForgotPassword" class="small">Forgot password?</a></div>
    <button type="submit" class="btn-ancora w-100">Sign in</button>
</form>

<div class="text-center mt-3">
    <p class="small">Don't have an account? <a asp-action="Register" asp-controller="Account">Register</a></p>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
