@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_AuthLayout";
}
<h2>Reset your password</h2>
<p class="sub">We'll email you a link to choose a new one.</p>
<form asp-action="ForgotPassword" method="post" novalidate>
    <div class="mb-4">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" autofocus />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn-ancora w-100">Send reset link</button>
</form>
<p class="mt-3 small"><a asp-action="Login">Back to sign in</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
