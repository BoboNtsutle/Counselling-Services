@using System.Security.Claims
@using Ancora.Web.Services.Supabase
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string a, string c) => a == area && c == controller ? "active" : "";
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Ancora Counselling Services</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="icon" type="image/svg+xml" href="~/images/ancora-mark.svg" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="shell">
    <aside class="sidebar">
        <a class="brand-logo" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Ancora Counselling Services">
            <img src="~/images/ancora-logo.svg" alt="Ancora Counselling Services" />
        </a>

        @* The full menu is defined here once, so nobody has to edit this file to add their module. *@
        <nav>
            @if (role == Roles.Admin)
            {
                <div class="nav-group">Admin</div>
                <a class="nav-link-a @Active("Admin", "Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                    Dashboard <span class="nav-owner">M6</span></a>
                <a class="nav-link-a @Active("Admin", "Appointments")" asp-area="Admin" asp-controller="Appointments" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
                    Appointments <span class="nav-owner">M2</span></a>
                <a class="nav-link-a @Active("Admin", "Availability")" asp-area="Admin" asp-controller="Availability" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    Availability</a>
                <a class="nav-link-a @Active("Admin", "Students")" asp-area="Admin" asp-controller="Students" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14c2.3 0 4 1.5 4.5 4"/></svg>
                    Student records</a>
                <a class="nav-link-a @Active("Admin", "Users")" asp-area="Admin" asp-controller="Users" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14c2.3 0 4 1.5 4.5 4"/></svg>
                    Users &amp; records <span class="nav-owner">M3</span></a>
                <a class="nav-link-a @Active("Admin", "Announcements")" asp-area="Admin" asp-controller="Announcements" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 10v4h3l6 4V6L7 10H4zM17 9a4 4 0 010 6"/></svg>
                    Announcements <span class="nav-owner">M4</span></a>
                <a class="nav-link-a @Active("Admin", "Reports")" asp-area="Admin" asp-controller="Reports" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 20V10M12 20V4M19 20v-7"/></svg>
                    Statistics <span class="nav-owner">M6</span></a>
            }
            @if (role == Roles.Psychologist)
            {
                <div class="nav-group">Psychologist</div>
                <a class="nav-link-a @Active("Psychologist", "Dashboard")" asp-area="Psychologist" asp-controller="Dashboard" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
                    My appointments <span class="nav-owner">M5</span></a>
                <a class="nav-link-a @Active("Psychologist", "Announcements")" asp-area="Psychologist" asp-controller="Announcements" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 10v4h3l6 4V6L7 10H4zM17 9a4 4 0 010 6"/></svg>
                    News</a>
                <a class="nav-link-a @Active("Psychologist", "Students")" asp-area="Psychologist" asp-controller="Students" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14c2.3 0 4 1.5 4.5 4"/></svg>
                    Student records</a>
            }
            @if (role == Roles.Student)
            {
                <div class="nav-group">Student</div>
                <a class="nav-link-a @Active("Student", "Dashboard")" asp-area="Student" asp-controller="Dashboard" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
                    Dashboard</a>
                <a class="nav-link-a @Active("Student", "Appointments")" asp-area="Student" asp-controller="Appointments" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
                    My appointments <span class="nav-owner">M5</span></a>
                <a class="nav-link-a @Active("Student", "Bookings")" asp-area="Student" asp-controller="Bookings" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h18v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/><path d="M16 3v4M8 3v4"/></svg>
                    Book a session <span class="nav-owner">M5</span></a>
                <a class="nav-link-a @Active("", "Announcements")" asp-area="" asp-controller="Announcements" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 10v4h3l6 4V6L7 10H4zM17 9a4 4 0 010 6"/></svg>
                    News <span class="nav-owner">M4</span></a>
            }
            <div class="nav-group">Account</div>
            <a class="nav-link-a @Active("", "Profile")" asp-area="" asp-controller="Profile" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4.3-6 8-6s7 2 8 6"/></svg>
                My profile <span class="nav-owner">M1</span></a>
        </nav>

        <div class="sidebar-foot">
            <div class="who"><strong>@User.Identity?.Name</strong><span>@role</span></div>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn-signout">Sign out</button>
            </form>
        </div>
    </aside>

    <main class="main">
        @if (TempData[Flash.Success] is string ok)
        {
            <div class="alert alert-success alert-dismissible fade show flash flash-ok" role="status">
                @ok
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData[Flash.Error] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show flash flash-err" role="alert">
                @err
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
